# Copy this file to .env and fill in real values for local docker compose up.
# Do NOT commit .env (it is in .gitignore via the standard Node pattern).
# In production (Render, Vercel, ...), set these in the platform's env-var UI.

# --- MongoDB credentials -------------------------------------------------
# Used by docker-compose.yml for the mongodb service AND assembled into
# MONGODB_URI for the backend. Required: compose will not start without
# them. They are read only when the mongodb_data volume is first created.
# Use URL-safe characters, e.g. openssl rand -hex 24.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=

# Only when running the backend outside compose (npm start in backend/):
# MONGODB_URI=mongodb://admin:PASSWORD@127.0.0.1:27017/financial-tracker?authSource=admin

# --- JWT signing secret --------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -hex 32
# Required by docker-compose.yml. With NODE_ENV=production (the compose
# default) server.js exits on startup if the secret is missing.
JWT_SECRET=

# --- CORS allowlist ------------------------------------------------------
# Comma-separated list of allowed origins. Default in dev: localhost:3000.
# In production list the real frontend origin(s) explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Reverse proxy -------------------------------------------------------
# Number of proxy hops in front of the API. render.yaml sets 1, which is
# not yet verified against X-Forwarded-For on a live request: too few hops
# puts every client behind a proxy into one rate-limit bucket, too many
# lets clients spoof their address. Leave unset when clients connect
# directly.
# TRUST_PROXY=1

# --- Other ---------------------------------------------------------------
# docker-compose.yml runs the API with NODE_ENV=production unless set here.
# NODE_ENV=development
